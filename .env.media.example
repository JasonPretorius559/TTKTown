# Copy selected settings into local/deployment environment variables.
# Leave source allowlists empty until image reuse is authorised.
CATALOGUE_APPROVED_SOURCES=
CATALOGUE_SOURCE_HOSTS=
CATALOGUE_IMAGE_HOSTS=
CATALOGUE_STORAGE_BYTES=2000000000
VIDEO_STORAGE_BYTES=5000000000

# Sightengine server credentials. Never prefix these with NEXT_PUBLIC.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Vercel sends this bearer secret to the daily cleanup route.
CRON_SECRET=
